<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.0</version>
		<relativePath/>
	</parent>

	<groupId>com.mzinx</groupId>
	<artifactId>mongodb-spring-demo-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>MongoDB Spring Demo Backend</name>
	<description>Demo web app backend showcasing the mongodb-spring-* libraries</description>

	<properties>
		<mongodb-spring.version>1.1.0</mongodb-spring.version>
		<!-- Not managed by the Spring Boot 4 BOM, so pin explicitly. -->
		<spring-session-data-mongodb.version>3.4.2</spring-session-data-mongodb.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>

		<!-- Spring Session backed by MongoDB: each browser gets an HTTP session
		     persisted in the `sessions` collection, shared across backend
		     instances and used to build the live "active sessions" presence list
		     that drives the private-messaging channels. -->
		<dependency>
			<groupId>org.springframework.session</groupId>
			<artifactId>spring-session-data-mongodb</artifactId>
			<version>${spring-session-data-mongodb.version}</version>
		</dependency>

		<!-- mongodb-spring libraries under demonstration.
		     message-queuing transitively brings change-stream + aggregation
		     + websocket; discovery provides instance heartbeats needed by
		     the AUTO_RECOVER / AUTO_SCALE change stream modes. -->
		<dependency>
			<groupId>com.mzinx</groupId>
			<artifactId>mongodb-spring-message-queuing</artifactId>
			<version>${mongodb-spring.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mzinx</groupId>
			<artifactId>mongodb-spring-discovery</artifactId>
			<version>${mongodb-spring.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.38</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.38</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
