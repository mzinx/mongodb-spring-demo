# Production environment (GKE).
# In production the app is served by nginx, which proxies /api and /ws to the
# backend Service. The frontend therefore uses same-origin relative paths and
# does NOT need a backend URL baked into the bundle at build time.
#
# The nginx upstream (backend Service host) is configured separately at image
# build time via the BACKEND_UPSTREAM build arg in the Dockerfile.
VITE_BACKEND_URL=
